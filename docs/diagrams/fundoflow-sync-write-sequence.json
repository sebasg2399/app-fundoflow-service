  "cards": [
    {
      "dot": "emerald",
      "title": "Local-first write",
      "items": [
        "SQLite INSERT is the only synchronous operation the supervisor sees",
        "Outbox makes the intent durable even if the device dies mid-sync",
        "Sync latency is fully decoupled from user-perceived latency"
      ]
    },
    {
      "dot": "cyan",
      "title": "Durable handoff",
      "items": [
        "HTTP 202 means 'accepted for processing', not 'processed'",
        "SQS absorbs device bursts at end-of-shift without dropping data",
        "Worker is stateless — restart or scale-out is safe"
      ]
    },
    {
      "dot": "amber",
      "title": "LWW + idempotency",
      "items": [
        "GetItem before PutItem compares updated_at to decide winner",
        "Same batch_id replayed: LWW skips identical items, idempotent",
        "mark synced_at only after DeleteMessage — no data loss on crash"
      ]
    }
  ]
