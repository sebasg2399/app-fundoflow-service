  "cards": [
    {
      "dot": "emerald",
      "title": "Offline-first",
      "items": [
        "Every mutation lands in local SQLite before any network call",
        "Outbox decouples user actions from sync availability",
        "App stays usable with no connectivity; sync resumes when back online"
      ]
    },
    {
      "dot": "cyan",
      "title": "Async by design",
      "items": [
        "HTTP server returns 202 immediately, processing happens out-of-band",
        "SQS absorbs burst when many devices sync at end of shift",
        "DLQ catches poisoned messages without blocking the main flow"
      ]
    },
    {
      "dot": "amber",
      "title": "Conflict-safe",
      "items": [
        "Client-generated UUIDs avoid server-id dependency offline",
        "Last-Write-Wins on updated_at is deterministic and idempotent",
        "Soft deletes (deleted_at) propagate through re-sync without data loss"
      ]
    }
  ]
}
