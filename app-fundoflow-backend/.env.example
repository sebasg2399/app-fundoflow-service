NODE_ENV=local
LOG_LEVEL=info

# HTTP server
PORT=3001

# AWS / LocalStack
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# DynamoDB tables (default coincide con terraform.auto.tfvars)
DYNAMODB_TABLE_TENANTS=fundoflow-local-tenants
DYNAMODB_TABLE_WORKERS=fundoflow-local-workers
DYNAMODB_TABLE_HARVEST_LOGS=fundoflow-local-harvest_logs
DYNAMODB_TABLE_SYNC_BATCHES=fundoflow-local-sync_batches

# SQS
SQS_QUEUE_URL=http://localhost:4566/000000000000/fundoflow-local-sync
SQS_DLQ_URL=http://localhost:4566/000000000000/fundoflow-local-sync-dlq

# Worker
WORKER_POLL_WAIT_SECONDS=20
WORKER_MAX_MESSAGES=10
