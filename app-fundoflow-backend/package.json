{
  "name": "@fundoflow/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend de sincronización offline-first para FundoFlow",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/http-main.ts",
    "dev:worker": "tsx watch src/worker-main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/http-main.js",
    "start:worker": "node dist/worker-main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter configured yet'"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.350.0",
    "@aws-sdk/client-sqs": "3.350.0",
    "@aws-sdk/lib-dynamodb": "3.350.0",
    "@hono/node-server": "1.13.7",
    "dotenv": "16.4.5",
    "hono": "4.6.10",
    "uuid": "11.0.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/uuid": "10.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
